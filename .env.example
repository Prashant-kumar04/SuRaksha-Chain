# ============================================================
# .env.example — Copy to .env and fill in your values
# ============================================================

# --- LOCAL DEVELOPMENT ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
BOOTSTRAP_PASSWORD=Demo@123
ENABLE_SEED_DATA=true
ENABLE_TAMPER_TESTS=false
CORS_ORIGINS=http://localhost:3000
# Leave empty locally — Vite proxy forwards /api calls to Express on :3000
VITE_API_URL=

# --- RENDER BACKEND (production) ---
# NODE_ENV=production
# PORT=10000
# DATA_DIR=/var/data
# APP_URL=https://suraksha-chain.onrender.com          <-- your Render URL
# CORS_ORIGINS=https://your-app.netlify.app            <-- your Netlify URL
# JWT_SECRET=<generate a long random string>
# BOOTSTRAP_PASSWORD=<strong password>
# ENABLE_SEED_DATA=true
# ENABLE_TAMPER_TESTS=false
